# 이 파일을 .env로 복사하고 본인 컴퓨터에서만 값을 입력하세요.
# 공공데이터포털에서 아래 두 API의 활용신청이 각각 승인되어야 합니다.
# https://www.data.go.kr/data/15156018/openapi.do
# https://www.data.go.kr/data/15155508/openapi.do
# 일반 인증키(Decoding)를 권장합니다. Encoding 키도 한 번만 디코딩합니다.
KHOA_API_KEY=
# 두 서비스에 서로 다른 키를 쓰는 경우에만 아래 값을 사용합니다.
KHOA_TIDE_API_KEY=
KHOA_OBSERVATION_API_KEY=

# OpenAI 플랫폼에서 직접 발급한 서버용 키. ChatGPT 구독과 별도 API 사용량입니다.
OPENAI_API_KEY=
# 이미지 입력과 Responses 구조화 출력을 지원하는, 계정에서 사용 가능한 모델
OPENAI_MODEL=gpt-4.1-mini

# 생략하면 프로젝트/data/sea_info.sqlite3에 자동 생성됩니다.
# SEA_INFO_DB_PATH=C:/KBR/sea_info_dashboard/data/sea_info.sqlite3
